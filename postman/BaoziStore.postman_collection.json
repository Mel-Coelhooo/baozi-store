{
  "info": {
    "name": "Baozi Store API",
    "description": "Testes da API REST da Baozi Store. Cliente: Melissa5598704 (nome + RU).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Cliente",
      "item": [
        {
          "name": "Criar Cliente (POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Melissa5598704\",\n  \"clienteDesde\": \"2026-11-22\"\n}" },
            "url": "{{baseUrl}}/clientes"
          }
        },
        { "name": "Listar Clientes (GET)", "request": { "method": "GET", "url": "{{baseUrl}}/clientes" } },
        { "name": "Consultar Cliente por ID (GET)", "request": { "method": "GET", "url": "{{baseUrl}}/clientes/1" } },
        {
          "name": "Atualizar Cliente (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Melissa5598704\",\n  \"clienteDesde\": \"2026-11-01\"\n}" },
            "url": "{{baseUrl}}/clientes/1"
          }
        },
        { "name": "Apagar Cliente (DELETE)", "request": { "method": "DELETE", "url": "{{baseUrl}}/clientes/1" } }
      ]
    },
    {
